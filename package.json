{
  "name": "manifold",
  "productName": "Manifold",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop explorer for directories and codebases in three dimensions",
  "author": "Manifold contributors",
  "license": "UNLICENSED",
  "main": ".vite/build/main.js",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "packageManager": "npm@11.21.1",
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-boundaries.mjs && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/boundaries.test.mjs && vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run format:check"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.10.0",
    "eslint": "10.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
